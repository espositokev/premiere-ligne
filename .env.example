# Copier ce fichier en .env.local et le remplir. Ne jamais commiter .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement, ne jamais exposer au navigateur

# Emails (Resend)
RESEND_API_KEY=
EMAIL_FROM="Première Ligne <notifications@premiereligne-app.fr>"

# Application
APP_URL=http://localhost:3000
CRON_SECRET=                         # au moins 16 caractères aléatoires
PREVIEW_COOKIE_SECRET=               # au moins 32 caractères aléatoires
DEV_EMAIL_REDIRECT=                  # en développement, tous les emails partent à cette adresse

# Données de démonstration (local uniquement)
SEED_PASSWORD=

# Tests de bout en bout : utiliser un Chrome déjà installé (facultatif)
PLAYWRIGHT_CHROME_PATH=
